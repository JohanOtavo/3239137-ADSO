# Copy to .env and fill in. The real .env is never versioned (article IX).
APP_NAME=film-gear
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stderr
LOG_LEVEL=info

# PostgreSQL 16. The engine starts empty: migrations own the schema.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=filmgear
DB_USERNAME=filmgear
DB_PASSWORD=
DB_SCHEMA=filmgear

# Token signing key. Long random string, never in the repository.
JWT_SECRET=

# First administrator. Created at boot, not seeded by the database.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Local photo storage.
PHOTOS_DIR=storage/app/photos

# Frontend origin allowed by CORS.
CORS_ORIGIN=http://localhost:5173
