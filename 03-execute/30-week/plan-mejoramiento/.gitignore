# Dependencies and build output: the plan requires these stay out of the repository.
vendor/
node_modules/
dist/
build/

# Secrets: only the example file is versioned.
.env
.env.*
!.env.example

# The repository root ignores this file, and the frontend needs it so that
# "npm ci" installs exact versions.
!package-lock.json

# Laravel
/api/storage/logs/*
/api/storage/framework/cache/data/*
/api/storage/framework/views/*
/api/storage/app/photos/*
/api/bootstrap/cache/*
.phpunit.cache/
.phpunit.result.cache
