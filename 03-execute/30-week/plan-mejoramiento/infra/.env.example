# Copy to .env before the first start. The real .env is never versioned.
DB_DATABASE=filmgear
DB_USERNAME=filmgear
DB_PASSWORD=change-this-password

# Long random string. Generate with:  openssl rand -base64 48
JWT_SECRET=

# First administrator. Created by the API at boot, not seeded by the database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Frontend origin allowed by CORS.
CORS_ORIGIN=http://localhost:5173

# The API URL baked into the frontend bundle at build time. It is the address
# the browser uses, not the one the containers use between them: the browser is
# outside the compose network and cannot resolve "api".
APP_API_URL=http://localhost:8000/api/v1
