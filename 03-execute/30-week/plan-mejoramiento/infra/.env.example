# Copy to .env before the first start. The real .env is never versioned.
DB_DATABASE=filmgear
DB_USERNAME=filmgear
DB_PASSWORD=change-this-password

# Long random string. Generate with:  openssl rand -base64 48
JWT_SECRET=

# First administrator. Created by the API at boot, not seeded by the database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Frontend origin allowed by CORS.
CORS_ORIGIN=http://localhost:5173
